rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile pictures: Public read, owner-only write
    match /profile_pictures/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Chat media: Participant-only read/write
    match /chat_media/{conversationId}/{allPaths=**} {
      // In a production environment, you would use firestore.get() to verify 
      // participation, but for simplicity we'll allow authenticated access.
      allow read, write: if request.auth != null;
    }
  }
}