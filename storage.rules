rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile pictures: Public read, owner-only write
    match /profile_pictures/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Chat media: Only verified participants of the conversation may read or write.
    // We look up the Firestore conversation doc to verify participation.
    match /chat_media/{conversationId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.uid in
             firestore.get(/databases/(default)/documents/conversations/$(conversationId))
               .data.participantIds;
    }
  }
}
