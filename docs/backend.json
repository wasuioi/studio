
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's public profile and core information within the HarmonyAI dating application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the UserProfile entity. This is typically the Firebase Authentication UID."
        },
        "name": {
          "type": "string",
          "description": "The user's display name."
        },
        "profilePhotoUrl": {
          "type": "string",
          "description": "URL to the user's profile photo.",
          "format": "uri"
        },
        "bio": {
          "type": "string",
          "description": "A short biographical description provided by the user."
        },
        "gender": {
          "type": "string",
          "description": "The user's gender identity."
        },
        "dateOfBirth": {
          "type": "string",
          "description": "The user's date of birth.",
          "format": "date"
        },
        "location": {
          "type": "string",
          "description": "The user's general location."
        },
        "isVerified": {
          "type": "boolean",
          "description": "Indicates if the user's identity has been successfully verified."
        },
        "verificationStatus": {
          "type": "string",
          "description": "The current status of the user's identity verification process."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "profilePhotoUrl",
        "isVerified",
        "verificationStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "Post": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Post",
      "type": "object",
      "description": "A social post shared by a user on their profile.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "content", "createdAt"]
    },
    "UserPersonality": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserPersonality",
      "type": "object",
      "description": "Stores the personality and communication style analysis results for a user.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "personalityType": { "type": "string" },
        "summary": { "type": "string" },
        "lastAnalysisDate": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "lastAnalysisDate"]
    },
    "Match": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Match",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user1Id": { "type": "string" },
        "user2Id": { "type": "string" },
        "matchScore": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected", "blocked"] },
        "isMutual": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "user1Id", "user2Id", "matchScore", "status", "isMutual", "createdAt"]
    },
    "Conversation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participantIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "participantIds", "createdAt", "updatedAt"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/user_profiles/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": { "$ref": "#/backend/entities/UserProfile" },
          "description": "Stores core user profile data."
        }
      },
      {
        "path": "/user_profiles/{userId}/posts/{postId}",
        "definition": {
          "entityName": "Post",
          "schema": { "$ref": "#/backend/entities/Post" },
          "description": "Social posts by the user."
        }
      },
      {
        "path": "/user_profiles/{userId}/personality/personality_data",
        "definition": {
          "entityName": "UserPersonality",
          "schema": { "$ref": "#/backend/entities/UserPersonality" },
          "description": "Stores AI personality analysis."
        }
      },
      {
        "path": "/matches/{matchId}",
        "definition": {
          "entityName": "Match",
          "schema": { "$ref": "#/backend/entities/Match" },
          "description": "Represents a potential or confirmed match."
        }
      }
    ]
  }
}
