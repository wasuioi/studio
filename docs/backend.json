{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's public profile within the HarmonyAI application.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "bio": { "type": "string" },
        "profilePhotoUrl": { "type": "string", "format": "uri" },
        "isVerified": { "type": "boolean" },
        "verificationStatus": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "isVerified", "createdAt", "updatedAt"]
    },
    "VerificationRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "VerificationRequest",
      "type": "object",
      "description": "Tracks an identity verification attempt.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string" },
        "aiScore": { "type": "number" },
        "aiReason": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Conversation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participantIds": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Message": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/user_profiles/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "description": "Primary user profile collection."
        }
      },
      {
        "path": "/user_profiles/{userId}/verification_requests/{requestId}",
        "definition": {
          "entityName": "VerificationRequest",
          "description": "User verification history."
        }
      },
      {
        "path": "/conversations/{conversationId}",
        "definition": {
          "entityName": "Conversation",
          "description": "Chat conversation metadata."
        }
      },
      {
        "path": "/conversations/{conversationId}/messages/{messageId}",
        "definition": {
          "entityName": "Message",
          "description": "Individual chat messages."
        }
      }
    ]
  }
}