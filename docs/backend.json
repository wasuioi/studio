
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's public profile and core information within the HarmonyAI dating application.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "profilePhotoUrl": { "type": "string", "format": "uri" },
        "bio": { "type": "string" },
        "gender": { "type": "string" },
        "dateOfBirth": { "type": "string", "format": "date" },
        "location": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "verificationStatus": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "isVerified", "createdAt", "updatedAt"]
    },
    "Post": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "content", "createdAt"]
    },
    "Conversation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participantIds": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "participantIds", "updatedAt"]
    },
    "Message": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "senderId", "text", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/user_profiles/{userId}",
        "definition": {
          "schema": { "$ref": "#/backend/entities/UserProfile" },
          "description": "User profiles."
        }
      },
      {
        "path": "/conversations/{conversationId}",
        "definition": {
          "schema": { "$ref": "#/backend/entities/Conversation" },
          "description": "Chat conversations."
        }
      },
      {
        "path": "/conversations/{conversationId}/messages/{messageId}",
        "definition": {
          "schema": { "$ref": "#/backend/entities/Message" },
          "description": "Messages within a conversation."
        }
      }
    ]
  }
}
