
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "The primary user record containing authentication and profile state.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "bio": { "type": "string" },
        "emailVerified": { "type": "boolean" },
        "identityVerified": { "type": "boolean" },
        "profileCompleted": { "type": "boolean" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "topMatches": {
          "type": "array",
          "items": { "type": "object" }
        },
        "personalityProfile": {
          "type": "object",
          "properties": {
            "traits": { "type": "object" },
            "summary": { "type": "string" }
          }
        }
      },
      "required": ["id", "email", "emailVerified", "identityVerified", "createdAt"]
    },
    "ChatRequest": {
      "title": "ChatRequest",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "matchScore": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected", "expired"] },
        "reason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "Match": {
      "title": "Match",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participantIds": { "type": "array", "items": { "type": "string" } },
        "score": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Conversation": {
      "title": "Conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participantIds": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Message": {
      "title": "Message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "description": "User profile and state."
        }
      },
      {
        "path": "/chat_requests/{requestId}",
        "definition": {
          "entityName": "ChatRequest",
          "description": "Requests to start a conversation."
        }
      },
      {
        "path": "/conversations/{conversationId}",
        "definition": {
          "entityName": "Conversation",
          "description": "Chat metadata."
        }
      },
      {
        "path": "/conversations/{conversationId}/messages/{messageId}",
        "definition": {
          "entityName": "Message",
          "description": "Individual chat messages."
        }
      }
    ]
  }
}
