
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isEmailVerified() {
      // Check the custom verified status in the user's profile
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.emailVerified == true;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId); // Simplified for custom verification flow
      
      match /private/verification {
        allow read, write: if isOwner(userId);
      }

      match /posts/{postId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId) && isEmailVerified();
      }
      
      match /personality/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isEmailVerified();
      }
      
      match /verification_requests/{requestId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isEmailVerified();
      }
    }

    match /bot_chats/{chatId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isEmailVerified();
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /matches/{matchId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && isEmailVerified();
      allow update: if isSignedIn() && request.auth.uid in resource.data.participantIds;
    }

    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && isEmailVerified();
      allow update: if isSignedIn() && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isSignedIn() && isEmailVerified() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }
    }
  }
}
