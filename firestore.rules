
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      
      match /posts/{postId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId) && isEmailVerified();
      }

      match /personality/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /verification_requests/{requestId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isEmailVerified();
      }
    }

    match /chat_requests/{requestId} {
      // Allow creating a request if signed in and verified
      allow create: if isSignedIn() && isEmailVerified();
      
      // Allow reading (get/list) if involved in the request
      // Listing requires query filters to match these conditions
      allow get: if isSignedIn() && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId
      );
      allow list: if isSignedIn() && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId
      );
      
      // Allow updating or deleting if involved in the request
      allow update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId
      );
    }

    match /bot_chats/{chatId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /conversations/{conversationId} {
      // Participant check for conversations
      allow read, update, delete: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      
      // Allow creation via verification or request acceptance
      allow create: if isSignedIn() && isEmailVerified();

      match /messages/{messageId} {
        // Access messages if a participant in the parent conversation
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isSignedIn() && isEmailVerified() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }
    }
  }
}
