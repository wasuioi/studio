rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isParticipant(participantIds) {
      return isSignedIn() && request.auth.uid in participantIds;
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      
      match /posts/{postId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId) && isEmailVerified();
      }

      match /personality/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /verification_requests/{requestId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isEmailVerified();
      }
    }

    // --- Chat Requests ---
    match /chat_requests/{requestId} {
      // Prevent users from creating requests as someone else
      allow create: if isSignedIn() && isEmailVerified() && request.resource.data.senderId == request.auth.uid;
      
      // Participants can view their own requests
      allow get: if isSignedIn() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
      
      // Listing requires query filters to match these conditions. 
      // Removed the limit restriction to prevent mismatches with client queries.
      allow list: if isSignedIn() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
      
      // Only receiver can update status, only sender can delete pending
      allow update: if isSignedIn() && (request.auth.uid == resource.data.receiverId || request.auth.uid == resource.data.senderId);
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
    }

    // --- Bot Interactions ---
    match /bot_chats/{chatId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // --- Conversations & Messages ---
    match /conversations/{conversationId} {
      allow read, update, delete: if isParticipant(resource.data.participantIds);
      
      // Allow creation if the current user is a participant
      allow create: if isSignedIn() && isEmailVerified() && request.auth.uid in request.resource.data.participantIds;

      match /messages/{messageId} {
        // Access messages only if a participant in the parent conversation
        allow read: if isSignedIn() && isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds);
        allow create: if isSignedIn() && isEmailVerified() && isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds) && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}